/-! Original model compositions shown in the talk. Each one is the sentence a
paper would write, as a Simulant declaration. They only compose the public
Simulant standard library (CeCILL-B, not vendored here). -/

import "std/models.sim"

/-- "Oblivious anonymous robots on a ring of n nodes, with chirality, unlimited
visibility and weak multiplicity detection, under an SSYNC scheduler." -/
def ringRobots : Model :=
  obliviousRobots (Graphs.Cycle (param n))
    Observe.full Frames.identity [occupied]
    (scheduler := Schedulers.SSync)

/-- The same robots with a light of three colors that every robot can read. -/
def luminousRobots : Model :=
  obliviousRobots (Graphs.Cycle (param n))
    Observe.full Frames.identity [colors, ownLight]
    (components := [Storage.Lights 3])
    (scheduler := Schedulers.SSync)

/-- "Myopic disoriented robots on a line, under FSYNC, that may crash at one
location": the setting of stand-up indulgent gathering. -/
def myopicRobots : Model :=
  obliviousRobots Graphs.Line
    (Observe.radius (param phi)) Frames.isomorphisms [occupied]
    (components := [Faults.CrashAt])
