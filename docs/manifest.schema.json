{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Glissade manifest, version 1",
  "type": "object",
  "required": ["schemaVersion", "version", "title", "fps", "scenes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "version": {"type": "string"},
    "title": {"type": "string"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "frame": {"type": "integer", "minimum": 0},
    "scene": {
      "type": "object",
      "required": ["id", "index", "name", "fps", "duration", "frameCount", "frames", "blocks", "cuts", "keyframes", "morphAnimations"],
      "properties": {
        "id": {"type": "string"},
        "index": {"type": "integer", "minimum": 0},
        "name": {"type": "string"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "frameCount": {"type": "integer", "minimum": 1},
        "frames": {"type": "array", "minItems": 1, "items": {"oneOf": [
          {"type": "string"},
          {"type": "object", "required": ["kind", "base", "patches"], "properties": {
            "kind": {"const": "svg-delta-v1"}, "base": {"$ref": "#/$defs/frame"},
            "patches": {"type": "array", "items": {"type": "object", "required": ["path", "svg"], "properties": {
              "path": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}},
              "svg": {"type": "string"}
            }}}
          }}
        ]}},
        "keyframes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/frame"}},
        "cuts": {"type": "array", "items": {"type": "object", "required": ["frame", "loop"], "properties": {
          "frame": {"$ref": "#/$defs/frame"}, "loop": {"type": "boolean"}
        }}},
        "blocks": {"type": "array"},
        "morphAnimations": {"type": "array"}
      }
    }
  }
}
